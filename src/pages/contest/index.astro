---
import { getCollection } from 'astro:content';
import '@fontsource/noto-serif-kr/400.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import YearNav from '../../components/YearNav.astro';
import ContestSectionNav from '../../components/ContestSectionNav.astro';
import ContestFactList from '../../components/ContestFactList.astro';
import { withBase } from '../../lib/routes';

const seasonOrder = { spring: 0, fall: 1 } as const;
const tableCellClass = (text: string) => text.length > 30 || text.includes('\n') ? 'is-prose' : undefined;
const contests = (await getCollection('contests'))
  .sort((a, b) =>
    b.data.year - a.data.year ||
    seasonOrder[b.data.season] - seasonOrder[a.data.season]
  );
const contestPeriods = contests.map((contest) => ({
  value: `${contest.data.year}-${contest.data.season}`,
  label: `${contest.data.year}: ${contest.data.season === 'spring' ? 'Spring' : 'Fall'}`,
}));
const sectionLabels = [
  ['intro', '대회 소개'], ['schedule', '일정 및 장소'],
  ['eligibility', '참가 자격'], ['application', '참가 신청'], ['awards', '시상 안내'],
  ['problems', '문제 안내'], ['judging', '채점 및 순위 산정'],
  ['rules', '참가자 유의사항'], ['contact', '문의'],
];

const groupRules = (rules: (typeof contests)[number]['data']['rules']) => {
  const groups: Array<Exclude<(typeof rules)[number], string> | string[]> = [];
  for (const rule of rules) {
    if (typeof rule === 'string') {
      const last = groups.at(-1);
      if (Array.isArray(last)) last.push(rule);
      else groups.push([rule]);
    } else groups.push(rule);
  }
  return groups;
};
---

<BaseLayout title="대회" description="Solvers가 주관하는 교내 알고리즘 대회를 소개합니다." bodyClass="detail-page reading-page contest-index-page">
  <main>
    <section class="plain-page-header shell">
      <h1>대회</h1>
    </section>
    <section class="plain-page-content shell">
      <YearNav items={contestPeriods} targetPrefix="contest-period" label="대회 연도와 시즌" />
      {contests.map((contest, index) => {
        const value = `${contest.data.year}-${contest.data.season}`;
        const poster = contest.data.images?.[0];
        const ruleGroups = groupRules(contest.data.rules);
        const awards = Array.isArray(contest.data.awards) ? contest.data.awards : [];
        const prizeLabels = [...new Set(awards.flatMap((track) => track.prizes?.map((prize) => prize.label) ?? []))];

        return (
          <section
            class="year-section"
            id={`contest-period-${value}`}
            role="tabpanel"
            aria-labelledby={`contest-period-tab-${value}`}
            hidden={index !== 0}
          >
            <div class="contest-period-content content-start">
              {poster && (
                <figure class="contest-poster">
                  <img
                    src={withBase(poster)}
                    alt={`${contest.data.title} 포스터`}
                    loading="lazy"
                  />
                </figure>
              )}
              {contest.data.fullName ? (
                <article class="contest-announcement" aria-labelledby={`contest-title-${value}`}>
                  <ContestSectionNav items={sectionLabels.map(([key, label]) => ({ id: `contest-${value}-${key}`, label }))} />
                  <section class="contest-guide-section" id={`contest-${value}-intro`}>
                    <h2>대회 소개</h2>
                  <header class="contest-introduction">
                    <h3 class="contest-title" id={`contest-title-${value}`}>{contest.data.title}</h3>
                    <p class="contest-full-name">{contest.data.fullName}</p>
                    {contest.data.slogan && <p class="contest-slogan">{contest.data.slogan}</p>}
                  </header>
                    <div class="contest-organizer-list">
                      <ContestFactList items={[
                        ...(contest.data.host !== undefined ? [{ label: '주최', description: contest.data.host }] : []),
                        ...(contest.data.organizer ? [{ label: '주관', description: contest.data.organizer }] : []),
                      ]} />
                    </div>
                  </section>
                  <section class="contest-guide-section contest-schedule" id={`contest-${value}-schedule`}>
                    <h2>일정 및 장소</h2>
                    <ContestFactList items={[
                      { label: '개최 일시', description: contest.data.schedule },
                      { label: '장소', description: contest.data.location },
                      ...(contest.data.scheduleDetails ?? []),
                    ]} />
                    {contest.data.timetable && <>
                      <h3>상세 일정</h3>
                      <ContestFactList items={contest.data.timetable.map((item) => ({ label: item.time, description: item.activity }))} />
                    </>}
                  </section>
                  <section class="contest-guide-section" id={`contest-${value}-eligibility`}>
                    <h2>참가 자격</h2>
                    <ContestFactList items={[
                      { label: '참가 대상', description: contest.data.audience },
                      { label: '참가 방식', description: contest.data.format },
                    ]} />
                    {typeof contest.data.proceedings === 'object' && (
                      contest.data.proceedings.trackAssignment ? (
                        <section class="contest-track-assignment" aria-labelledby={`track-assignment-${value}`}>
                          <h3 id={`track-assignment-${value}`}>트랙 배정 방식</h3>
                          <ul class="contest-list">
                            {contest.data.proceedings.trackAssignment.map((assignment) => (
                              <li>
                                <strong>{assignment.track}</strong>
                                <ul>{assignment.eligibility.map((item) => <li>{item}</li>)}</ul>
                              </li>
                            ))}
                            {contest.data.proceedings.trackAssignmentNote && <li>{contest.data.proceedings.trackAssignmentNote}</li>}
                          </ul>
                        </section>
                      ) : <ul class="contest-list contest-track-list" aria-label="대회 트랙">
                        {contest.data.proceedings.tracks.map((track) => <li>{track}</li>)}
                      </ul>
                    )}
                  </section>
                  <section class="contest-guide-section" id={`contest-${value}-application`}>
                    <h2>참가 신청</h2>
                    {contest.data.participationDetails?.length
                      ? <ContestFactList items={contest.data.participationDetails} />
                      : <p class="contest-pending">추가 예정</p>}
                  </section>
                  <section class="contest-guide-section" id={`contest-${value}-awards`}>
                    <h2>시상 안내</h2>
                    {Array.isArray(contest.data.awards)
                      ? <table class="contest-awards-table" aria-label="트랙별 시상 안내">
                          <thead><tr><th scope="col">구분</th>{contest.data.awards.map((item) => <th scope="col" class={tableCellClass(item.label)}>{item.label}</th>)}</tr></thead>
                          <tbody>
                            {prizeLabels.map((label) => (
                              <tr><th scope="row" class={tableCellClass(label)}>{label}</th>{awards.map((track) => {
                                const description = track.prizes?.find((prize) => prize.label === label)?.description ?? '—';
                                return <td class={tableCellClass(description)}>{description}</td>;
                              })}</tr>
                            ))}
                            {!prizeLabels.length && <tr><th scope="row">시상 내용</th>{awards.map((item) => <td class={tableCellClass(item.description ?? '')}>{item.description ?? '추가 예정'}</td>)}</tr>}
                          </tbody>
                        </table>
                      : <p class="contest-pending">{contest.data.awards ?? '추가 예정'}</p>
                    }
                  </section>
                  <section class="contest-guide-section" id={`contest-${value}-problems`}>
                    <h2>문제 안내</h2>
                    {typeof contest.data.proceedings === 'object' ? (
                      <ContestFactList items={contest.data.proceedings.details?.filter((item) => item.section === 'problems') ?? []} />
                    ) : <p class="contest-pending">{contest.data.proceedings ?? '추가 예정'}</p>}
                  </section>
                  <section class="contest-guide-section" id={`contest-${value}-judging`}>
                    <h2>채점 및 순위 산정</h2>
                    {typeof contest.data.proceedings === 'object' ? <>
                      <ul class="contest-list">
                        <li><strong>채점 플랫폼</strong>{': '}{contest.data.proceedings.platformUrl
                          ? <a class="contest-platform-link" href={contest.data.proceedings.platformUrl} target="_blank" rel="noopener noreferrer">{contest.data.proceedings.platform}</a>
                          : contest.data.proceedings.platform
                        }</li>
                      </ul>
                      <ContestFactList items={contest.data.proceedings.details?.filter((item) => item.section === 'judging') ?? []} />
                      <section class="contest-method" aria-labelledby={`scoring-${value}`}>
                        <h3 id={`scoring-${value}`}>채점 방식</h3>
                        <p><strong>{contest.data.proceedings.ranking}</strong></p>
                        <ul class="contest-list">
                          {contest.data.proceedings.scoringDescription?.map((paragraph) => <li>{paragraph}</li>)}
                          {contest.data.proceedings.scoringNote && <li>{contest.data.proceedings.scoringNote}</li>}
                        </ul>
                      </section>
                      {contest.data.proceedings.rankingCriteria && <section class="contest-method" aria-labelledby={`ranking-${value}`}>
                        <h3 id={`ranking-${value}`}>순위 산정 방식</h3>
                        <ul class="contest-list">
                          {contest.data.proceedings.rankingCriteria.map((item) => (
                            <li><strong>{item.label}</strong>{': '}{item.description}</li>
                          ))}
                        </ul>
                      </section>}
                    </> : <p class="contest-pending">추가 예정</p>}
                  </section>
                  <section class="contest-guide-section" id={`contest-${value}-rules`}>
                    <h2>참가자 유의사항</h2>
                    {ruleGroups.map((rule) => Array.isArray(rule) ? (
                      <ul class="contest-list contest-general-rules">
                        {rule.map((text) => <li>{text}</li>)}
                      </ul>
                    ) : (
                        <section class="contest-rule">
                          <h3>{rule.label}</h3>
                          {rule.groups ? <>
                            <p>{rule.description}</p>
                            <ul class="contest-list">
                              {rule.groups.map((group) => <li>
                                <strong>{group.url
                                  ? <a href={group.url} target="_blank" rel="noopener noreferrer">{group.label}</a>
                                  : group.label}</strong>
                                <ul>
                                  {group.links?.map((link) => <li><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a></li>)}
                                  {group.items?.map((item) => <li>{item}</li>)}
                                </ul>
                              </li>)}
                            </ul>
                          </> : <ul class="contest-list">
                            <li>{rule.description.split('\n')[0]}
                            {rule.links && <ul>
                              {rule.links.map((link) => <li><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label}</a></li>)}
                            </ul>}
                            {rule.items && <ul>{rule.items.map((item) => <li>{item}</li>)}</ul>}
                            </li>
                            {rule.description.split('\n').slice(1).filter((line) => line.trim()).map((line) => <li>{line}</li>)}
                            {rule.note && <li>
                              {rule.noteUrl
                                ? <a href={rule.noteUrl} target="_blank" rel="noopener noreferrer">{rule.note}</a>
                                : rule.note}
                              {rule.noteItems && <ul>{rule.noteItems.map((item) => <li>{item}</li>)}</ul>}
                            </li>}
                          </ul>}
                        </section>
                    ))}
                  </section>
                  <section class="contest-guide-section" id={`contest-${value}-contact`}>
                    <h2>문의</h2>
                    {typeof contest.data.contact === 'object'
                      ? <ul class="contest-list">
                          <li><strong>담당자</strong>{': '}{contest.data.contact.name}</li>
                          <li><strong>이메일</strong>{': '}<a class="contest-email" href={`mailto:${contest.data.contact.email}`}>{contest.data.contact.email}</a></li>
                        </ul>
                      : <p class="contest-pending">{contest.data.contact ?? '추가 예정'}</p>
                    }
                  </section>
                </article>
              ) : (
                <p class:list={['contest-description', { 'is-standalone': !poster }]}>{contest.data.summary}</p>
              )}
            </div>
          </section>
        );
      })}
    </section>
  </main>
</BaseLayout>
