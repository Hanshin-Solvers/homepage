---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/routes';
---

<BaseLayout title="페이지를 찾을 수 없습니다" description="요청한 페이지를 찾을 수 없습니다." ogImage={null}>
  <main class="not-found shell">
    <span>404</span>
    <h1>길을 잠시 잃었어요.</h1>
    <p>Solvers 홈에서 다시 시작할 수 있어요.</p>
    <a class="button button-primary" href={withBase()}>홈으로 돌아가기 →</a>
  </main>
</BaseLayout>
