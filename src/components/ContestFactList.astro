---
interface Props {
  items: Array<{
    label?: string;
    description: string;
    descriptionUrl?: string;
    listStyle?: 'unordered' | 'ordered';
    link?: { label: string; url: string };
  }>;
}
const { items } = Astro.props;
---

<ul class="contest-list">
  {items.map((item) => {
    const lines = item.description.split('\n').filter((line) => line.trim());
    const List = item.listStyle === 'ordered' ? 'ol' : 'ul';
    return (
      <li>
        {item.label && <strong>{item.label}</strong>}{lines.length > 1 ? (
          <List>{lines.map((line) => <li>{line}</li>)}</List>
        ) : <>{item.label ? ': ' : ''}{item.descriptionUrl
          ? <a href={item.descriptionUrl} target="_blank" rel="noopener noreferrer">{item.description}</a>
          : item.description}</>}
        {item.link && <>{' ('}<a href={item.link.url} target="_blank" rel="noopener noreferrer">{item.link.label}</a>{')'}</>}
      </li>
    );
  })}
</ul>
